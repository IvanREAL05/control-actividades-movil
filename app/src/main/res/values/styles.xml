<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ToolbarTitleStyle" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Estilo para los campos de texto del justificante -->
    <style name="CampoTextoJustificante" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <!-- Tamaño mínimo de altura táctil -->
        <item name="android:minHeight">48dp</item>

        <!-- Padding interno -->
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>

        <!-- Texto -->
        <item name="android:textColor">#212121</item>
        <item name="android:textSize">16sp</item>

        <!-- Fondo y bordes -->
        <item name="android:background">@drawable/campo_texto_bg</item>

        <!-- Hint color -->
        <item name="android:textColorHint">#757575</item>
    </style>

    <!-- Estilo para botones llenos (Filled Button) -->
    <style name="Widget.MaterialComponents.Button.Filled" parent="Widget.MaterialComponents.Button">
        <!-- Color de fondo por defecto -->
        <item name="backgroundTint">?attr/colorPrimary</item>
        <!-- Color de texto -->
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <!-- Esquinas redondeadas -->
        <item name="cornerRadius">20dp</item>
        <!-- Elevación -->
        <item name="elevation">4dp</item>
        <!-- Padding interno -->
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <!-- Estilo base de la aplicación -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/background_light</item>
    </style>

    <!-- Estilos para texto -->
    <style name="TextTitle">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextSubtitle">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextBody">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextCaption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/text_tertiary</item>
    </style>

    <!-- Estilos para cards -->
    <style name="CardStyle" parent="@style/Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">4dp</item>
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="android:layout_margin">8dp</item>
    </style>

    <style name="CardStyleSmall" parent="CardStyle">
        <item name="cardCornerRadius">8dp</item>
        <item name="cardElevation">2dp</item>
        <item name="android:layout_margin">4dp</item>
    </style>

    <!-- Estilos para botones -->
    <style name="ButtonPrimary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="ButtonSecondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/primary</item>
        <item name="android:textColor">@color/primary</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <!-- Estilo para el ActionBar -->
    <style name="ActionBarStyle" parent="Widget.MaterialComponents.ActionBar.Primary">
        <item name="background">@color/primary</item>
        <item name="titleTextStyle">@style/ActionBarTitleStyle</item>
    </style>

    <style name="ActionBarTitleStyle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Estilos para FAB -->
    <style name="FABStyle" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="backgroundTint">@color/primary</item>
        <item name="tint">@android:color/white</item>
        <item name="elevation">6dp</item>
    </style>

</resources>