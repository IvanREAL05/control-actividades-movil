<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Icono de estado -->
        <TextView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="📋"
            android:textSize="18sp"
            android:gravity="center"
            android:background="@drawable/circle_background_light"
            android:layout_marginEnd="12dp" />

        <!-- Información principal -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <TextView
                android:id="@+id/tvTituloActividad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Título de la Actividad"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:ellipsize="end"
                android:maxLines="1" />

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tvEstadoActividad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✅ Entregado"
                    android:textSize="12sp"
                    android:textColor="#4CAF50"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvFechaEntrega"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15/01/2024"
                    android:textSize="11sp"
                    android:textColor="#999999" />
            </LinearLayout>
        </LinearLayout>

        <!-- Puntuación -->
        <TextView
            android:id="@+id/tvPuntosActividad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="20/20 pts"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#4CAF50"
            android:background="@drawable/rounded_background_light"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:minWidth="50dp"
            android:gravity="center" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>