<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/itemContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@android:color/white"
    android:clickable="false"
    android:focusable="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp"
        android:gravity="center_vertical">

        <!-- Avatar circular con inicial -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="16dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#E8F5E8">

            <TextView
                android:id="@+id/tvInicialAlumno"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="A"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#2E7D32"
                android:gravity="center" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Contenedor de información -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Nombre del alumno -->
            <TextView
                android:id="@+id/tvNombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre del Alumno"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#212121"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Matrícula con icono -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📝"
                    android:textSize="12sp"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/tvMatricula"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="S20140001"
                    android:textSize="13sp"
                    android:textColor="#666666" />

            </LinearLayout>

            <!-- Estado actual de la actividad -->
            <TextView
                android:id="@+id/tvEstadoActividad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sin registrar actividad"
                android:textSize="11sp"
                android:textColor="#999999"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- Contenedor del Spinner -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:minWidth="120dp">

            <!-- Label del Spinner -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Estado"
                android:textSize="12sp"
                android:textColor="#666666"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <!-- Spinner con diseño mejorado -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardCornerRadius="8dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="#F5F5F5">

                <Spinner
                    android:id="@+id/spinnerEstado"
                    android:layout_width="110dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:paddingHorizontal="8dp"
                    android:background="@android:color/transparent"
                    android:spinnerMode="dropdown" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Indicador de cambio guardado -->
            <View
                android:id="@+id/indicadorGuardado"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:background="@drawable/circulo_estado_presente"
                android:visibility="invisible" />

        </LinearLayout>

    </LinearLayout>

    <!-- Barra de progreso para indicar guardado -->
    <View
        android:id="@+id/progressIndicator"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:layout_gravity="bottom"
        android:background="#4CAF50"
        android:visibility="gone" />

    <!-- Línea divisora sutil (opcional) -->
    <View
        android:id="@+id/dividerLine"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_gravity="bottom"
        android:background="#E0E0E0"
        android:layout_marginHorizontal="20dp"
        android:visibility="gone" />

</com.google.android.material.card.MaterialCardView>