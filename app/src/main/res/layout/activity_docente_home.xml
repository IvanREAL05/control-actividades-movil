<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:fitsSystemWindows="true">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary_blue"
        android:elevation="8dp">

        <TextView
            android:id="@+id/toolbar_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📝 Registro de Actividades"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:layout_gravity="center"/>
    </androidx.appcompat.widget.Toolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <!-- Card de información de clase -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                android:layout_marginBottom="24dp"
                android:backgroundTint="@android:color/white">

                <LinearLayout
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tvInfoClase"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cargando clase actual..."
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"/>

                    <TextView
                        android:id="@+id/tvObservaciones"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:background="@drawable/bg_observaciones"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:visibility="gone" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Botón principal: Registrar Actividad -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegistrarActividad"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:text="✨ REGISTRAR ACTIVIDAD"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:backgroundTint="@color/primary_blue"
                android:elevation="8dp"
                android:layout_marginBottom="24dp"
                android:textAllCaps="false"
                app:cornerRadius="16dp"/>

            <!-- Botones secundarios: Asistencia y Justificante -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRegistrarAsistencia"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_weight="1"
                    android:text="✅\nAsistencia"
                    android:textSize="16sp"
                    android:textColor="@color/primary_blue"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="@android:color/white"
                    app:strokeColor="@color/primary_blue"
                    app:strokeWidth="2dp"
                    app:cornerRadius="16dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRegistrarJustificante"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_weight="1"
                    android:text="📋\nJustificantes"
                    android:textSize="16sp"
                    android:textColor="@color/primary_blue"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@android:color/white"
                    app:strokeColor="@color/primary_blue"
                    app:strokeWidth="2dp"
                    app:cornerRadius="16dp"/>
            </LinearLayout>

            <!-- Botones secundarios: Estudiantes y Estadísticas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVerLista"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_weight="1"
                    android:text="👥\nEstudiantes"
                    android:textSize="16sp"
                    android:textColor="@color/primary_blue"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="@android:color/white"
                    app:strokeColor="@color/primary_blue"
                    app:strokeWidth="2dp"
                    app:cornerRadius="16dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVerEstadisticas"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_weight="1"
                    android:text="📊\nEstadísticas"
                    android:textSize="16sp"
                    android:textColor="@color/primary_blue"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@android:color/white"
                    app:strokeColor="@color/primary_blue"
                    app:strokeWidth="2dp"
                    app:cornerRadius="16dp"/>
            </LinearLayout>

            <!-- Botón cambiar bitácora -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBitacora"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="📆 Cambiar Bitácora"
                android:textColor="@color/text_secondary"
                android:textStyle="bold"
                android:backgroundTint="@android:color/white"
                app:strokeColor="@color/primary_blue"
                app:strokeWidth="2dp"
                app:cornerRadius="16dp"
                android:layout_marginBottom="24dp"/>

            <!-- Actividades recientes -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📋 ACTIVIDADES RECIENTES"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/tvActividadesRecientes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No hay actividades registradas hoy"
                android:textColor="@color/text_secondary"
                android:textStyle="italic"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
