<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA"
    tools:context=".HorarioDocenteActivity">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/gradient_toolbar"
        android:elevation="6dp">

        <TextView
            android:id="@+id/toolbar_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="BITÁCORA"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"/>
    </androidx.appcompat.widget.Toolbar>

    <!-- Header con información del profesor -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        android:backgroundTint="@color/primary">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/txtTituloHorario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mi Horario Semanal"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtNombreProfesor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Cargando..."
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:alpha="0.9" />

            <TextView
                android:id="@+id/txtTotalClases"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="0 clases programadas"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:alpha="0.8" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Instrucciones -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="8dp"
        android:text="Toca una clase para seleccionarla"
        android:textColor="#666"
        android:textSize="14sp"
        android:gravity="center" />

    <!-- Loading indicator -->
    <ProgressBar
        android:id="@+id/progressBarHorario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="50dp"
        android:visibility="visible" />

    <!-- ScrollView para el contenido del horario -->
    <ScrollView
        android:id="@+id/scrollViewHorario"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/layoutDias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp" />

    </ScrollView>

    <!-- Mensaje cuando no hay clases -->
    <LinearLayout
        android:id="@+id/layoutSinClases"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:padding="40dp">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_schedule"
            android:alpha="0.3"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No hay clases programadas"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#999"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Tu horario semanal está vacío"
            android:textSize="14sp"
            android:textColor="#999"
            android:gravity="center" />

    </LinearLayout>

    <!-- Botón flotante para refrescar -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabRefrescar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_margin="24dp"
        android:src="@drawable/ic_refresh"
        android:contentDescription="Refrescar horario"
        app:backgroundTint="@color/primary"
        app:tint="@android:color/white" />

</LinearLayout>