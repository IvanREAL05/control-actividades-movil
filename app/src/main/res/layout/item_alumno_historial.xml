<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardAlumno"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@android:color/white"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- 🔥 HEADER DEL ALUMNO - SIEMPRE VISIBLE -->
        <LinearLayout
            android:id="@+id/layoutHeader"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <!-- Avatar del alumno -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                android:layout_marginEnd="12dp">

                <TextView
                    android:id="@+id/tvIniciales"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="AA"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:background="@color/blue1"
                    android:gravity="center" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Información principal -->
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/tvNombreAlumnoHistorial"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nombre del Alumno"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorPrimaryDark"
                    android:ellipsize="end"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/tvProgresoActividades"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📚 2/5 actividades • 🏆 85.5 pts promedio"
                    android:textSize="13sp"
                    android:textColor="#666666"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Indicadores visuales -->
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginStart="8dp">

                <!-- Calificación promedio -->
                <TextView
                    android:id="@+id/tvPromedioCalif"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8.5"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#4CAF50"
                    android:background="@drawable/circle_background_light"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:minWidth="36dp"
                    android:gravity="center" />

                <!-- Icono de expansión -->
                <ImageView
                    android:id="@+id/ivExpandir"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_expand_more"
                    android:layout_marginTop="4dp"
                    app:tint="#999999"
                    android:contentDescription="Expandir detalles" />
            </LinearLayout>
        </LinearLayout>

        <!-- 🔥 SECCIÓN EXPANDIBLE - DETALLES DE ACTIVIDADES -->
        <LinearLayout
            android:id="@+id/layoutDetallesExpandible"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:animateLayoutChanges="true">

            <!-- Divisor -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginHorizontal="16dp" />

            <!-- Header de actividades -->
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="8dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📋 Actividades Entregadas"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorPrimaryDark" />

                <TextView
                    android:id="@+id/tvTotalPuntos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total: 170/200 pts"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FF9800"
                    android:background="@drawable/rounded_background_orange"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp" />
            </LinearLayout>

            <!-- Lista de actividades -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerActividadesAlumno"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingBottom="8dp"
                android:nestedScrollingEnabled="false" />

            <!-- Resumen final -->
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:paddingTop="8dp"
                android:background="#F8F9FA"
                android:gravity="center_vertical">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📊 Resumen Académico"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#666666" />

                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp">

                        <TextView
                            android:id="@+id/tvEntregadas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✅ 2 entregadas"
                            android:textSize="11sp"
                            android:textColor="#4CAF50"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/tvPendientes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⏳ 3 pendientes"
                            android:textSize="11sp"
                            android:textColor="#FF9800" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Botón ver más detalles -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVerDetalles"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Ver más"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    app:cornerRadius="16dp"
                    android:backgroundTint="@color/blue2"
                    android:textColor="@android:color/white"
                    android:paddingHorizontal="12dp"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- 🔥 INDICADOR DE ESTADO EN ESQUINA -->
    <TextView
        android:id="@+id/tvEstadoIndicador"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⭐"
        android:textSize="12sp"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:background="@drawable/circle_background_small"
        android:textColor="@android:color/white"
        android:padding="4dp"
        android:visibility="gone" />

</com.google.android.material.card.MaterialCardView>