<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardAlumno"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="3dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="@android:color/white"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- HEADER DEL ALUMNO -->
        <LinearLayout
            android:id="@+id/layoutHeader"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <!-- Fila principal con avatar e info -->
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:gravity="center_vertical">

                <!-- Avatar con badge de estado -->
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        app:cardCornerRadius="28dp"
                        app:cardElevation="4dp"
                        app:strokeWidth="3dp"
                        app:strokeColor="#E3F2FD">

                        <TextView
                            android:id="@+id/tvIniciales"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="AA"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@android:color/white"
                            android:background="@drawable/gradient_avatar_bg"
                            android:gravity="center" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Badge de estado -->
                    <TextView
                        android:id="@+id/tvEstadoIndicador"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:text="⭐"
                        android:textSize="10sp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/circle_badge_bg"
                        android:gravity="center"
                        android:visibility="gone" />
                </FrameLayout>

                <!-- Información del alumno -->
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/tvNombreAlumnoHistorial"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nombre del Alumno"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#1A237E"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:letterSpacing="0.01" />

                    <TextView
                        android:id="@+id/tvProgresoActividades"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="2 de 5 actividades completadas"
                        android:textSize="13sp"
                        android:textColor="#757575"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Calificación y expansión -->
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_marginStart="12dp">

                    <!-- Badge de calificación -->
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/rounded_grade_bg"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvPromedioCalif"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="8.5"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="#4CAF50" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Promedio"
                            android:textSize="9sp"
                            android:textColor="#81C784"
                            android:textAllCaps="true"
                            android:letterSpacing="0.05" />
                    </LinearLayout>

                    <!-- Icono de expansión -->
                     <ImageView
                        android:id="@+id/ivExpandir"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_expand_more"
                        android:layout_marginTop="8dp"
                        app:tint="#BDBDBD"
                        android:background="@drawable/circle_ripple_bg"
                        android:padding="4dp"
                        android:contentDescription="Expandir detalles" />
                </LinearLayout>
            </LinearLayout>

            <!-- Barra de progreso visual -->
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingBottom="12dp">

                <!-- Indicadores rápidos -->
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">

                    <!-- Chip 1 - Porcentaje de avance -->
                    <TextView
                        android:id="@+id/tvChipPorcentaje"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📚 0%"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#2196F3"
                        android:background="@drawable/chip_blue_bg"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:layout_marginEnd="6dp" />

                    <!-- Chip 2 -->
                    <TextView
                        android:id="@+id/tvTotalPuntos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏆 170/200 pts"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#FF9800"
                        android:background="@drawable/chip_orange_bg"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                </LinearLayout>

                <!-- Barra de progreso -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="6dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/progress_bar_background" />

                    <View
                        android:id="@+id/viewProgreso"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/progress_bar_fill" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- SECCIÓN EXPANDIBLE - DETALLES -->
        <LinearLayout
            android:id="@+id/layoutDetallesExpandible"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:animateLayoutChanges="true"
            android:background="#FAFAFA">

            <!-- Divisor decorativo -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@drawable/gradient_divider" />

            <!-- ============================================ -->
            <!-- NUEVA SECCIÓN: CALIFICACIONES DE PARCIALES -->
            <!-- ============================================ -->
            <LinearLayout
                android:id="@+id/layoutSeccionParciales"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#F8F9FA"
                android:visibility="visible">

                <!-- Header de Parciales -->
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:paddingBottom="12dp"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="20dp"
                            android:background="@drawable/accent_bar_purple"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📋 Calificaciones de Parciales"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#6A1B9A" />
                    </LinearLayout>

                    <!-- Promedio de parciales -->
                    <TextView
                        android:id="@+id/tvPromedioParciales"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="9.2"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:background="@drawable/circle_purple_bg"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:minWidth="40dp"
                        android:gravity="center" />
                </LinearLayout>

                <!-- Tarjetas de Parciales -->
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:paddingBottom="16dp"
                    android:weightSum="2">

                    <!-- Parcial 1 -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="4dp"
                        app:strokeWidth="2dp"
                        app:strokeColor="#E1BEE7"
                        app:cardBackgroundColor="@android:color/white">

                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="16dp"
                            android:gravity="center">

                            <!-- Icono y título -->
                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:layout_marginBottom="8dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="📝"
                                    android:textSize="20sp"
                                    android:layout_marginEnd="6dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Parcial 1"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="#6A1B9A" />
                            </LinearLayout>

                            <!-- Calificación -->
                            <TextView
                                android:id="@+id/tvCalifParcial1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="9.0"
                                android:textSize="32sp"
                                android:textStyle="bold"
                                android:textColor="#8E24AA"
                                android:layout_marginBottom="4dp" />

                            <!-- Estado -->
                            <TextView
                                android:id="@+id/tvEstadoParcial1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="✓ Calificado"
                                android:textSize="11sp"
                                android:textColor="#66BB6A"
                                android:background="@drawable/chip_success_bg"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp" />

                            <!-- Fecha (opcional) -->
                            <TextView
                                android:id="@+id/tvFechaParcial1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="15 Sept 2024"
                                android:textSize="10sp"
                                android:textColor="#9E9E9E"
                                android:layout_marginTop="6dp"
                                android:visibility="gone" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Parcial 2 -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="4dp"
                        app:strokeWidth="2dp"
                        app:strokeColor="#E1BEE7"
                        app:cardBackgroundColor="@android:color/white">

                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="16dp"
                            android:gravity="center">

                            <!-- Icono y título -->
                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:layout_marginBottom="8dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="📝"
                                    android:textSize="20sp"
                                    android:layout_marginEnd="6dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Parcial 2"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="#6A1B9A" />
                            </LinearLayout>

                            <!-- Calificación -->
                            <TextView
                                android:id="@+id/tvCalifParcial2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="9.5"
                                android:textSize="32sp"
                                android:textStyle="bold"
                                android:textColor="#8E24AA"
                                android:layout_marginBottom="4dp" />

                            <!-- Estado -->
                            <TextView
                                android:id="@+id/tvEstadoParcial2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="✓ Calificado"
                                android:textSize="11sp"
                                android:textColor="#66BB6A"
                                android:background="@drawable/chip_success_bg"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp" />

                            <!-- Fecha (opcional) -->
                            <TextView
                                android:id="@+id/tvFechaParcial2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="20 Nov 2024"
                                android:textSize="10sp"
                                android:textColor="#9E9E9E"
                                android:layout_marginTop="6dp"
                                android:visibility="gone" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Mensaje cuando no hay parciales calificados -->
                <LinearLayout
                    android:id="@+id/layoutNoParciales"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="24dp"
                    android:gravity="center"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📋"
                        android:textSize="40sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sin calificaciones de parciales"
                        android:textSize="13sp"
                        android:textColor="#9E9E9E"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Las calificaciones aparecerán aquí"
                        android:textSize="11sp"
                        android:textColor="#BDBDBD"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Divisor entre secciones -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:background="@drawable/section_divider" />
            </LinearLayout>

            <!-- ============================================ -->
            <!-- SECCIÓN ORIGINAL: ACTIVIDADES -->
            <!-- ============================================ -->

            <!-- Header de actividades -->
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:paddingBottom="12dp"
                android:background="#F5F5F5"
                android:gravity="center_vertical">

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="20dp"
                        android:background="@drawable/accent_bar"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Actividades Entregadas"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#1A237E" />
                </LinearLayout>

                <!-- Contador -->
                <TextView
                    android:id="@+id/tvEntregadas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:background="@drawable/circle_count_bg"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:minWidth="28dp"
                    android:gravity="center" />
            </LinearLayout>

            <!-- Lista de actividades -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerActividadesAlumno"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false" />

            <!-- Footer con resumen y acción -->
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/footer_gradient_bg">

                <!-- Divisor sutil -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginHorizontal="16dp" />

                <!-- Contenido del footer -->
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <!-- Resumen -->
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">

                            <LinearLayout
                                android:orientation="vertical"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="⏳ Pendientes"
                                    android:textSize="11sp"
                                    android:textColor="#FFA726"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvPendientes"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="3 actividades"
                                    android:textSize="10sp"
                                    android:textColor="#FFB74D"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Botón de acción -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVerDetalles"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Ver detalles completos"
                        android:textSize="12sp"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        app:cornerRadius="20dp"
                        app:icon="@drawable/ic_arrow_forward"
                        app:iconGravity="end"
                        app:iconSize="16dp"
                        app:iconTint="@android:color/white"
                        android:backgroundTint="#2196F3"
                        android:textColor="@android:color/white"
                        android:paddingHorizontal="16dp"
                        app:elevation="2dp"
                        style="@style/Widget.MaterialComponents.Button" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>